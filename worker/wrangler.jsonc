{
  "name": "triplith-r-game-server",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
